num1 = float(input("first number: "))
num2 = float(input("second number: "))

operation = input("Choose + - * /: ")

if operation == "+":
    print(num1 + num2)
elif operation == "-":
    print(num1 - num2)
elif operation == "*":
    print(num1 * num2)
elif operation == "/":
    print(num1/num2)
else:
    print("syntax error")